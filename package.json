{
  "name": "scrum-canvas",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-based local Scrum board for MySQL and PostgreSQL",
  "main": "server/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && node server/index.cjs",
